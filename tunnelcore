#!/bin/bash
# ═══════════════════════════════════════════════════════════════
#  TunnelCore v1.0.0
#  Gestión de VPS / SSH / Tunneling
#  Autor: J DAVID AG
# ═══════════════════════════════════════════════════════════════
set -uo pipefail

# ── Detectar directorio real del script (resolviendo enlaces simbólicos) ────
SOURCE="${BASH_SOURCE[0]}"
while [ -h "$SOURCE" ]; do
    DIR="$(cd -P "$(dirname "$SOURCE")" >/dev/null 2>&1 && pwd)"
    SOURCE="$(readlink "$SOURCE")"
    [[ "$SOURCE" != /* ]] && SOURCE="$DIR/$SOURCE"
done
TC_SCRIPT_DIR="$(cd -P "$(dirname "$SOURCE")" >/dev/null 2>&1 && pwd)"

# Fallback si se ejecuta desde symlink en /usr/local/bin o /bin
if [[ ! -f "${TC_SCRIPT_DIR}/core/ui.sh" && -f "/opt/tunnelcore/core/ui.sh" ]]; then
    TC_SCRIPT_DIR="/opt/tunnelcore"
fi
TC_VERSION="1.0.0"

# ── Cargar librerías core ─────────────────────────────────────
source "${TC_SCRIPT_DIR}/core/ui.sh"
source "${TC_SCRIPT_DIR}/core/utils.sh"
source "${TC_SCRIPT_DIR}/core/config.sh"
source "${TC_SCRIPT_DIR}/core/lang.sh"

# ── Cargar módulos disponibles ────────────────────────────────
[[ -f "${TC_SCRIPT_DIR}/modules/users.sh" ]] && source "${TC_SCRIPT_DIR}/modules/users.sh"
[[ -f "${TC_SCRIPT_DIR}/modules/protocols.sh" ]] && source "${TC_SCRIPT_DIR}/modules/protocols.sh"
[[ -f "${TC_SCRIPT_DIR}/modules/banner.sh" ]] && source "${TC_SCRIPT_DIR}/modules/banner.sh"
[[ -f "${TC_SCRIPT_DIR}/modules/limiter.sh" ]] && source "${TC_SCRIPT_DIR}/modules/limiter.sh"
[[ -f "${TC_SCRIPT_DIR}/modules/checkusers.sh" ]] && source "${TC_SCRIPT_DIR}/modules/checkusers.sh"
[[ -f "${TC_SCRIPT_DIR}/modules/network.sh" ]] && source "${TC_SCRIPT_DIR}/modules/network.sh"
[[ -f "${TC_SCRIPT_DIR}/modules/vps.sh" ]] && source "${TC_SCRIPT_DIR}/modules/vps.sh"
[[ -f "${TC_SCRIPT_DIR}/modules/settings.sh" ]] && source "${TC_SCRIPT_DIR}/modules/settings.sh"

# ── Verificar root ────────────────────────────────────────────
tc_require_root

# ── Inicializar configuración ─────────────────────────────────
tc_config_init
tc_config_load

# ═══════════════════════════════════════════════════════════════
#  MÓDULOS / SUBMENÚS
# ═══════════════════════════════════════════════════════════════

tc_module_users() {
    if declare -f tc_users_menu >/dev/null; then
        tc_users_menu
    else
        tc_clear
        tc_title "$(_t 'menu_users')"
        tc_msg_warn "Módulo de usuarios no encontrado."
        tc_pause
    fi
}

